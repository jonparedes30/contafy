# ============================================================================
# CONTAFY - Configuración de Variables de Entorno
# ============================================================================
# INSTRUCCIONES:
# 1. Copiar este archivo a .env en la raíz del proyecto
# 2. Llenar los valores según el entorno
# 3. NUNCA subir .env a Git (está en .gitignore)
# 4. Cada máquina debe tener su propio .env
# ============================================================================

# ============================================================================
# 🔧 ENTORNO Y DJANGO CORE
# ============================================================================

# ENVIRONMENT: development, staging, production
ENVIRONMENT=development

# DEBUG: True en desarrollo, False en producción
# SEGURIDAD: En producción, SIEMPRE debe ser False
DEBUG=True

# SECRET_KEY: Clave secreta para sesiones y tokens
# Generar: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# SEGURIDAD: Diferentes para cada entorno, NUNCA hardcodear, mínimo 50 caracteres en PROD
SECRET_KEY=dev-secret-key-only-for-local-development-change-in-production

# ALLOWED_HOSTS: Dominios permitidos (separados por comas)
# Desarrollo: localhost,127.0.0.1
# Producción: tu-dominio.com,www.tu-dominio.com
ALLOWED_HOSTS=localhost,127.0.0.1,127.0.0.1:8000,localhost:8000

# CSRF_TRUSTED_ORIGINS: Orígenes CSRF permitidos (opcional, por defecto se usan ALLOWED_HOSTS)
# CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:8000

# ============================================================================
# 🗄️ BASE DE DATOS - PostgreSQL (Producción y Docker)
# ============================================================================

# OPCIÓN A: DATABASE_URL (para Render, Heroku, servicios en la nube)
# Formato: postgres://usuario:password@host:puerto/nombre_db
# Ejemplo: postgres://user:pass@db.example.com:5432/contafy_db
# Si está configurado, se ignoran las variables POSTGRES_* abajo
# DATABASE_URL=

# OPCIÓN B: Variables PostgreSQL explícitas (para Docker y desarrollo)
# Se usan si DATABASE_URL no tiene valor

# Nombre de la base de datos
POSTGRES_DB=contafy_db

# Usuario de PostgreSQL
POSTGRES_USER=contafy

# Contraseña de PostgreSQL (CAMBIAR EN PRODUCCIÓN)
POSTGRES_PASSWORD=changeme_in_production

# Host del servidor PostgreSQL
# Docker: db (nombre del servicio en docker-compose)
# Local: localhost
# Remoto: db.example.com
POSTGRES_HOST=db

# Puerto PostgreSQL (por defecto 5432)
POSTGRES_PORT=5432

# Tiempo máximo de conexión en segundos
# SQLite (desarrollo local): usar 0 (no soporta connection pooling)
# PostgreSQL (Docker/producción): usar 600 para reutilizar conexiones
CONN_MAX_AGE=600

# REDIS_URL: URL de conexión a Redis para caché (opcional)
# Si no se define, se usa LocMemCache (caché en memoria local)
# Docker: redis://redis:6379/0
# Producción: redis://user:pass@host:6379/0
# REDIS_URL=

# AI_PROVIDER: Proveedor de IA a utilizar (openai, gemini, mock)
# Si no se define, se usa 'gemini' por defecto
# mock: respuestas simuladas para testing sin API keys
AI_PROVIDER=gemini

# ============================================================================
# ✉️ CONFIGURACIÓN DE EMAIL
# ============================================================================
# Necesario para: reset de contraseña, notificaciones

# Servidor SMTP
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True

# Credenciales (para Gmail: usar contraseña de aplicación)
# Pasos Gmail: https://myaccount.google.com/apppasswords
EMAIL_HOST_USER=noreply@contafy.com
EMAIL_HOST_PASSWORD=tu_app_password

# Dirección remitente
DEFAULT_FROM_EMAIL=noreply@contafy.com

# ============================================================================
# 📱 WHATSAPP - TWILIO (OPCIONAL)
# ============================================================================

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# ============================================================================
# 📊 LOGGING Y MONITOREO
# ============================================================================

# Nivel de logs: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ============================================================================
# 💾 RESPALDOS AUTOMÁTICOS (OPCIONAL)
# ============================================================================

BACKUP_ENABLED=True
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE=daily

# ============================================================================
# 🌍 LOCALIZACIÓN
# ============================================================================

TIME_ZONE=America/Guayaquil
LANGUAGE_CODE=es

# ============================================================================
# 🔐 SEGURIDAD - NOTAS CRÍTICAS
# ============================================================================
# ⚠️ NUNCA commit .env a Git
# ⚠️ NUNCA compartir credenciales en mensajes
# ⚠️ En producción, usar variables de entorno del servidor (no archivo .env)
# ⚠️ Cambiar SECRET_KEY requiere que usuarios se vuelvan a loguear
# ⚠️ DEFAULT_FROM_EMAIL debe ser válido para envíos reales
